{
  "schemaVersion": 1,
  "id": "fixlib",
  "version": "${version}",
  "name": "FixLib",
  "description": "Compatibility fork of ukulib for Minecraft Fabric",
  "authors": [
    "fixpot47"
  ],
  "contact": {
    "homepage": "https://github.com/fixpot47/fixlib",
    "issues": "https://github.com/fixpot47/fixlib/issues",
    "sources": "https://github.com/fixpot47/fixlib"
  },
  "license": "MPL-2.0",
  "icon": "assets/ukulib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.uku3lig.ukulib.fabric.UkulibFabric"
    ],
    "modmenu": [
      "net.uku3lig.ukulib.fabric.ModMenuRegistrar"
    ]
  },
  "depends": {
    "minecraft": "^26.3",
    "fabricloader": ">=0.19",
    "fabric-resource-loader-v1": "*",
    "fabric-command-api-v2": "*",
    "fabric-key-mapping-api-v1": "*"
  },
  "mixins": [
    "ukulib-common.mixins.json"
  ],
  "contributors": [
    "uku (original ukulib author)"
  ],
  "provides": [
    "ukulib"
  ],
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  }
}
